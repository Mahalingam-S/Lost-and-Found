# Server Configuration
PORT=5000
JWT_SECRET=campus_lost_found_secret_key_2026_jwt
MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_found

# Enable Real SMS Mode (Set to true when using an SMS provider)
ENABLE_REAL_SMS=false

# -------------------------------------------------------------
# Option 1: Fast2SMS (Recommended for Indian Mobile Numbers +91)
# Free registration at: https://www.fast2sms.com/
# -------------------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# -------------------------------------------------------------
# Option 2: 2Factor.in (Popular Indian SMS Gateway)
# Free registration at: https://2factor.in/
# -------------------------------------------------------------
TWO_FACTOR_API_KEY=your_two_factor_api_key_here

# -------------------------------------------------------------
# Option 3: Twilio SMS (Global SMS Provider)
# -------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
